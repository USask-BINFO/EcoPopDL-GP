# Example config for ./run.sh
# Use: ./run.sh --config config/run.example.polyploid.env --force

MODE=polyploid
WORKDIR=./runs/test_d4_oil
STAGES=train

# ------------------------------------------------------------------
# Genotype entry point
# ------------------------------------------------------------------
# Recommended style: set ONE generic source and let the launcher choose
# the correct starting step.
#
# Supported GENOTYPE_SOURCE_TYPE values:
#   auto    = infer from the path or prefix
#   axiom   = raw Axiom export table (csv/tsv/txt)
#   plink   = existing BED/BIM/FAM prefix, or a .bed/.bim/.fam member path
#   pfile   = existing PGEN/PVAR/PSAM prefix, or a .pgen/.pvar/.psam member path
#   vcf     = existing .vcf, .vcf.gz, or .vcf.bgz file
#
# Alias accepted for convenience:
#   link -> plink
# This synthetic test sample is a marker-by-sample allele-call matrix, so the
# example run starts from the raw-Axiom-style path and then runs QC + Beagle
# imputation.
GENOTYPE_SOURCE_TYPE=axiom
GENOTYPE_SOURCE="$REPO_DIR/Test/bnapus/synthetic_bnapus_allele_calls.txt"

# Examples:
# GENOTYPE_SOURCE_TYPE=axiom
# GENOTYPE_SOURCE=/absolute/path/to/axiom_export.tsv
#
# GENOTYPE_SOURCE_TYPE=plink
# GENOTYPE_SOURCE=/absolute/path/to/final_genotype_prefix
# or
# GENOTYPE_SOURCE=/absolute/path/to/final_genotype_prefix.bed
#
# GENOTYPE_SOURCE_TYPE=pfile
# GENOTYPE_SOURCE=/absolute/path/to/final_genotype_prefix
# or
# GENOTYPE_SOURCE=/absolute/path/to/final_genotype_prefix.pgen
#
# GENOTYPE_SOURCE_TYPE=vcf
# GENOTYPE_SOURCE=/absolute/path/to/final_genotype.vcf.gz

# Optional companion files when starting from PLINK/PFILE/VCF
EXISTING_VCF=
EXISTING_HAP_BLOCK_FILE=

# Legacy fields are still supported, but the generic source above is cleaner.
# AXIOM_FILE=/absolute/path/to/axiom_export.tsv
# EXISTING_PLINK_PREFIX=/absolute/path/to/final_genotype_prefix
# EXISTING_PFILE_PREFIX=/absolute/path/to/final_genotype_prefix
# VCF_SOURCE=/absolute/path/to/final_genotype.vcf.gz

AXIOM_SEP=tab
REF_MODE=none
# Recommended for raw-Axiom starts so intermediate files use a dataset-specific
# prefix instead of a hardcoded crop name.
GENOTYPE_OUTPUT_PREFIX=synthetic_bnapus_d4
# Optional in this synthetic test config because REF_MODE=none.
FASTA=
FOUNDERS_CSV=

THREADS=8
JAVA_MEM_GB=16
QC_GENO=0.02
QC_MIND=0.02
QC_MAF=0.01
DR2_THRESHOLD=0.8
HARD_CALL_THRESHOLD=0.1
RUN_BEAGLE_IMPUTATION=1

# ------------------------------------------------------------------
# Phenotype
# ------------------------------------------------------------------
TRAIT_FILE="$REPO_DIR/Test/bnapus/synthetic_oil.csv"
TRAIT_COL=OIL_DB
TARGET_COL=OIL_DB
SAMPLE_COL=Name
LOCATION_COL=Location
YEAR_COL=Year
POP_COL=Pop
# Leave blank to let the phenotype builder preserve extra design columns
# such as Reps automatically instead of collapsing them into one mean row.
GROUP_COLS=
COVARIATE_COLS=Year,Reps

# ------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------
TRIAL_FILE="$REPO_DIR/Test/bnapus/synthetic_trial.csv"
ENV_SOURCE_FILE=
ENV_SAMPLE_COL=
ENV_LOCATION_COL=
ENV_YEAR_COL=
ENV_LAT_COL=
ENV_LON_COL=
ENV_PLACE_COL=
ENV_START_COL=
ENV_END_COL=
# Optional simpler path: leave TRIAL_FILE blank and build it from TRAIT_FILE
# (or a separate ENV_SOURCE_FILE) using location/year plus season settings.
# TRIAL_FILE=
# ENV_SOURCE_FILE=/absolute/path/to/Env_source.csv
# ENV_SAMPLE_COL=Name
# ENV_LOCATION_COL=Location
# ENV_YEAR_COL=Year
# ENV_LAT_COL=lat
# ENV_LON_COL=lon
# ENV_PLACE_COL=place
# ENV_START_COL=start
# ENV_END_COL=end
# ENV_SEASON_START_MM_DD=05-26
# ENV_SEASON_END_MM_DD=09-15
# ENV_SEASON_LENGTH_DAYS=
ENV_WINDOWS=20
ENV_ALIGN=calendar
ENV_VARS=tmax_C,tmin_C,precip_mm,par_allsky,srad_allsky,wind_m_s,vpd_kPa,gdd,cloud_pct,kt,daylength_h
ENV_WORKERS=4

# ------------------------------------------------------------------
# Tensor generation / model inputs
# ------------------------------------------------------------------
GENE_GFF=/birl2/data/brassica/thulani/Research/CMPT898/CMPT-PLSC_819_Project/Github/EcoPopDL-GP/Scripts/Sample_data/polyploid/Bnapus_3DH.genes_20211001.gff3
TE_ANNOTATION=
TE_GFF=/birl2/data/brassica/thulani/Research/CMPT898/CMPT-PLSC_819_Project/Github/EcoPopDL-GP/Scripts/Sample_data/polyploid/Bna_genome_v3.1.fa.19K_repeat.gff
HOMOEOLOG_PAIR_FILE=/birl2/data/brassica/thulani/Research/CMPT898/CMPT-PLSC_819_Project/Github/EcoPopDL-GP/Scripts/Sample_data/polyploid/Bnapus_A_C_homoeolog_pairs.tsv
COLOR_MODE=allele_combination

# ------------------------------------------------------------------
# ADMIXTURE
# ------------------------------------------------------------------
RUN_ADMIXTURE=1
ADMIXTURE_K=
ADMIXTURE_K_RANGE=2:3
ADMIXTURE_SELECTION_METHOD=elbow

# ------------------------------------------------------------------
# Training overrides (leave blank to use defaults in the research script)
# ------------------------------------------------------------------
EPOCHS=
BATCH_SIZE=
LEARNING_RATE=
CV_FOLDS=
